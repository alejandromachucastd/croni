# Copia este archivo como ".env" y completa los valores.

# --- Login con Google (obligatorio, es el único método de acceso) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Base de datos (opcional en local) ---
# Si dejas esto vacío, los datos se guardan en archivos JSON dentro de
# data/ (funciona sin internet, ideal para probar en tu computadora).
# Si lo llenas con una cadena de conexión de MongoDB Atlas (plan gratis
# M0), los datos se guardan ahí en vez de en disco — necesario en hosts
# con disco efímero como Render.
# MONGODB_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/
# MONGODB_DB=croni

# --- Sesiones (opcional) ---
# Clave fija para firmar las cookies de sesión. Si no la pones, se genera
# una automáticamente; en hosts con disco efímero eso hace que todos
# tengan que volver a iniciar sesión después de cada redeploy. Pon aquí
# cualquier cadena larga y aleatoria para evitarlo.
# SESSION_SECRET=

# Puerto del servidor (opcional, Render lo define solo)
# PORT=3000
